<Window x:Class="SyntheticDataGenerator.UI.AdvancedOptionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Advanced Options"
        Height="240"
        Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Icon="Assets/app.ico">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Seed"
                       Margin="0,0,0,4" />
            <TextBox x:Name="SeedInput"
                     Padding="4"
                     MaxWidth="200"
                     HorizontalAlignment="Left" />
        </StackPanel>

        <CheckBox x:Name="EnableDataOverwriteCheckBox"
                  Grid.Row="1"
                  Content="Enable data overwrite"
                  Margin="0,0,0,8" />

        <TextBlock Grid.Row="2"
                   Text="When enabled, you can select individual columns to overwrite existing data."
                   TextWrapping="Wrap"
                   Foreground="#666666"
                   VerticalAlignment="Top" />

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Cancel"
                    MinWidth="80"
                    Margin="0,0,8,0"
                    Padding="12,4"
                    IsCancel="True"
                    Click="OnCancelClick" />
            <Button Content="OK"
                    MinWidth="80"
                    Padding="12,4"
                    IsDefault="True"
                    Click="OnOkClick" />
        </StackPanel>
    </Grid>
</Window>
