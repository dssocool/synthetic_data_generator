<UserControl x:Class="SyntheticDataGenerator.UI.Controls.SqlScopePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SyntheticDataGenerator.UI.Controls">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <local:ColumnSelectionCheckboxVisibilityConverter x:Key="ColumnCheckboxVisibility" />
    </UserControl.Resources>
    <Border BorderBrush="#CCCCCC"
            BorderThickness="1"
            Padding="8"
            Background="White">
        <Grid>
            <!-- Scope tree with inline column metadata -->
            <StackPanel>
                <TextBlock x:Name="ScopeHeaderText"
                           Text="Include databases, schemas, or tables"
                           Margin="0,0,0,8"
                           FontWeight="SemiBold" />

                <TextBlock Text="Search"
                           Margin="0,0,0,4"
                           Foreground="#666666" />
                <TextBox x:Name="SearchInput"
                         Margin="0,0,0,8"
                         Padding="4"
                         TextChanged="OnSearchTextChanged" />

                <CheckBox x:Name="SelectAllCheckBox"
                          Content="Select all"
                          Margin="0,0,0,4"
                          Checked="OnSelectAllChanged"
                          Unchecked="OnSelectAllChanged" />

                <TreeView x:Name="ScopeTree"
                          Height="280"
                          BorderBrush="#DDDDDD"
                          BorderThickness="1">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="IsSelected" Value="{Binding IsTreeSelected, Mode=TwoWay}" />
                            <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}" />
                            <EventSetter Event="Expanded" Handler="OnTreeItemExpanded" />
                            <EventSetter Event="Collapsed" Handler="OnTreeItemCollapsed" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <Grid Margin="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Checked="OnItemCheckChanged"
                                          Unchecked="OnItemCheckChanged"
                                          IsThreeState="True">
                                    <CheckBox.Visibility>
                                        <MultiBinding Converter="{StaticResource ColumnCheckboxVisibility}">
                                            <Binding Path="Kind" />
                                            <Binding Path="AllowColumnSelection"
                                                     RelativeSource="{RelativeSource AncestorType=local:SqlScopePicker}" />
                                        </MultiBinding>
                                    </CheckBox.Visibility>
                                </CheckBox>
                                <Grid Grid.Column="1"
                                      Margin="8,0,8,0"
                                      Cursor="Hand"
                                      MouseLeftButtonUp="OnItemLabelClick">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" MinWidth="80" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               VerticalAlignment="Center"
                                               Text="{Binding DisplayName}"
                                               Foreground="#222222" />
                                    <TextBlock Grid.Column="1"
                                               VerticalAlignment="Center"
                                               Margin="16,0,0,0"
                                               Text="{Binding ColumnMetadataText}"
                                               Foreground="#666666"
                                               FontSize="11"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding ColumnMetadataText}" />
                                </Grid>
                                <TextBlock Grid.Column="2"
                                           VerticalAlignment="Center"
                                           Foreground="#888888"
                                           Text=">"
                                           Cursor="Hand"
                                           MouseLeftButtonUp="OnItemLabelClick"
                                           Visibility="{Binding CanExpand, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>

                <TextBlock x:Name="StatusText"
                           Margin="0,8,0,0"
                           Foreground="#666666"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
