<UserControl x:Class="SyntheticDataGenerator.UI.Controls.SqlScopePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SyntheticDataGenerator.UI.Controls">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <local:ColumnSelectionCheckboxVisibilityConverter x:Key="ColumnCheckboxVisibility" />
    </UserControl.Resources>
    <Border BorderBrush="#CCCCCC"
            BorderThickness="1"
            Padding="8"
            Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="280" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="ScopeHeaderText"
                       Grid.Row="0"
                       Text="Include databases, schemas, or tables"
                       Margin="0,0,0,8"
                       FontWeight="SemiBold" />

            <StackPanel Grid.Row="1" Margin="0,0,0,8">
                <TextBlock Text="Search"
                           Margin="0,0,0,4"
                           Foreground="#666666" />
                <TextBox x:Name="SearchInput"
                         Padding="4"
                         TextChanged="OnSearchTextChanged" />
            </StackPanel>

            <CheckBox x:Name="SelectAllCheckBox"
                      Grid.Row="2"
                      Content="Select all"
                      Margin="0,0,0,4"
                      Checked="OnSelectAllChanged"
                      Unchecked="OnSelectAllChanged" />

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="240" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="300" MinWidth="220" />
                </Grid.ColumnDefinitions>

                <TreeView x:Name="ScopeTree"
                          Grid.Column="0"
                          BorderBrush="#DDDDDD"
                          BorderThickness="1"
                          SelectedItemChanged="OnScopeTreeSelectedItemChanged">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="IsSelected" Value="{Binding IsTreeSelected, Mode=TwoWay}" />
                            <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}" />
                            <EventSetter Event="Expanded" Handler="OnTreeItemExpanded" />
                            <EventSetter Event="Collapsed" Handler="OnTreeItemCollapsed" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <Grid Margin="2"
                                  MouseRightButtonUp="OnItemRightClick">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Checked="OnItemCheckChanged"
                                          Unchecked="OnItemCheckChanged"
                                          IsThreeState="True">
                                    <CheckBox.Visibility>
                                        <MultiBinding Converter="{StaticResource ColumnCheckboxVisibility}">
                                            <Binding Path="Kind" />
                                            <Binding Path="AllowColumnSelection"
                                                     RelativeSource="{RelativeSource AncestorType=local:SqlScopePicker}" />
                                        </MultiBinding>
                                    </CheckBox.Visibility>
                                </CheckBox>
                                <Grid Grid.Column="1"
                                      Margin="8,0,8,0"
                                      Cursor="Hand"
                                      MouseLeftButtonUp="OnItemLabelClick">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" MinWidth="80" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               VerticalAlignment="Center"
                                               Text="{Binding DisplayName}"
                                               Foreground="#222222" />
                                    <TextBlock Grid.Column="1"
                                               VerticalAlignment="Center"
                                               Margin="16,0,0,0"
                                               Text="{Binding ColumnMetadataText}"
                                               Foreground="#666666"
                                               FontSize="11"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding ColumnMetadataText}" />
                                </Grid>
                                <TextBlock Grid.Column="2"
                                           VerticalAlignment="Center"
                                           Foreground="#888888"
                                           Text=">"
                                           Cursor="Hand"
                                           MouseLeftButtonUp="OnItemLabelClick"
                                           Visibility="{Binding CanExpand, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>

                <Border Grid.Column="2"
                        BorderBrush="#DDDDDD"
                        BorderThickness="1"
                        Background="#FAFAFA"
                        Padding="12">
                    <Grid>
                        <TextBlock x:Name="ColumnDetailsEmpty"
                                   Text="Select a column to view details."
                                   Foreground="#888888"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center" />

                        <ScrollViewer x:Name="ColumnDetailsPanel"
                                      Visibility="Collapsed"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock x:Name="DetailColumnNameText"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#1A5276"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="DetailTableNameText"
                                           Margin="0,2,0,12"
                                           Foreground="#666666"
                                           FontSize="11"
                                           TextWrapping="Wrap" />

                                <TextBlock Text="Data type"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,2" />
                                <TextBlock x:Name="DetailDataTypeText"
                                           Foreground="#444444"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,10" />

                                <TextBlock Text="Nullable"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,2" />
                                <TextBlock x:Name="DetailNullableText"
                                           Foreground="#444444"
                                           Margin="0,0,0,10" />

                                <TextBlock Text="Keys &amp; relationships"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,2" />
                                <TextBlock x:Name="DetailKeysText"
                                           Foreground="#444444"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,10" />

                                <TextBlock Text="Custom dependencies"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,2" />
                                <TextBlock x:Name="DetailCustomDepsText"
                                           Foreground="#444444"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,10" />

                                <TextBlock Text="Value list / file"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,2" />
                                <TextBlock x:Name="DetailValueListText"
                                           Foreground="#444444"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,12" />

                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="DetailCustomDepButton"
                                            Content="Custom dependency..."
                                            Padding="8,4"
                                            Margin="0,0,8,0"
                                            Click="OnDetailCustomDepClick" />
                                    <Button x:Name="DetailValueListButton"
                                            Content="Value list or file..."
                                            Padding="8,4"
                                            Click="OnDetailValueListClick" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <TextBlock x:Name="StatusText"
                       Grid.Row="4"
                       Margin="0,8,0,0"
                       Foreground="#666666"
                       TextWrapping="Wrap" />
        </Grid>
    </Border>
</UserControl>
