<UserControl x:Class="SyntheticDataGenerator.UI.Controls.SqlScopePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <Border BorderBrush="#CCCCCC"
            BorderThickness="1"
            Padding="8"
            Background="White">
        <StackPanel>
            <TextBlock Text="Include databases, schemas, or tables"
                       Margin="0,0,0,8"
                       FontWeight="SemiBold" />

            <TextBlock Text="Search"
                       Margin="0,0,0,4"
                       Foreground="#666666" />
            <TextBox x:Name="SearchInput"
                     Margin="0,0,0,8"
                     Padding="4"
                     TextChanged="OnSearchTextChanged" />

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="BackButton"
                        Grid.Column="0"
                        Content="Back"
                        Padding="8,2"
                        Margin="0,0,8,0"
                        Visibility="Collapsed"
                        Click="OnBackClick" />
                <TextBlock x:Name="BreadcrumbText"
                           Grid.Column="1"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="#444444" />
            </Grid>

            <CheckBox x:Name="SelectAllCheckBox"
                      Content="Select all"
                      Margin="0,0,0,4"
                      Checked="OnSelectAllChanged"
                      Unchecked="OnSelectAllChanged" />

            <TreeView x:Name="ScopeTree"
                      Height="180"
                      BorderBrush="#DDDDDD"
                      BorderThickness="1">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                        <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}" />
                        <EventSetter Event="Expanded" Handler="OnTreeItemExpanded" />
                        <EventSetter Event="Collapsed" Handler="OnTreeItemCollapsed" />
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <CheckBox VerticalAlignment="Center"
                                  Content="{Binding DisplayName}"
                                  IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Checked="OnItemCheckChanged"
                                  Unchecked="OnItemCheckChanged"
                                  IsThreeState="True" />
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

            <TextBlock x:Name="StatusText"
                       Margin="0,8,0,0"
                       Foreground="#666666"
                       TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</UserControl>
