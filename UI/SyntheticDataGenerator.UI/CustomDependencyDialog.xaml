<Window x:Class="SyntheticDataGenerator.UI.CustomDependencyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Custom Dependency"
        Height="480"
        Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Icon="Assets/app.ico">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Select related columns to link with the source column."
                   TextWrapping="Wrap"
                   Foreground="#666666"
                   Margin="0,0,0,12" />

        <TextBlock Grid.Row="1"
                   x:Name="SourceColumnText"
                   FontWeight="Bold"
                   Foreground="#1A5276"
                   Margin="0,0,0,12" />

        <StackPanel Grid.Row="2" Margin="0,0,0,8">
            <TextBlock Text="Search columns"
                       Margin="0,0,0,4" />
            <TextBox x:Name="SearchInput"
                     Padding="4"
                     TextChanged="OnSearchTextChanged" />
        </StackPanel>

        <ListBox x:Name="ResultsList"
                 Grid.Row="3"
                 SelectionMode="Extended"
                 DisplayMemberPath="DisplayText"
                 BorderBrush="#DDDDDD"
                 BorderThickness="1"
                 Margin="0,0,0,8" />

        <TextBlock Grid.Row="4"
                   x:Name="StatusText"
                   Foreground="#666666"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8" />

        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Cancel"
                    MinWidth="80"
                    Margin="0,0,8,0"
                    Padding="12,4"
                    IsCancel="True"
                    Click="OnCancelClick" />
            <Button Content="OK"
                    MinWidth="80"
                    Padding="12,4"
                    IsDefault="True"
                    Click="OnOkClick" />
        </StackPanel>
    </Grid>
</Window>
