<Window x:Class="SyntheticDataGenerator.UI.ExecuteRuleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Execute Rule"
        Height="280"
        Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Icon="Assets/app.ico">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Generate synthetic data into SQL Server using the settings below."
                   TextWrapping="Wrap"
                   Margin="0,0,0,16" />

        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="Rows per table"
                       Margin="0,0,0,4" />
            <TextBox x:Name="RowsPerTableInput"
                     Padding="4"
                     MaxWidth="200"
                     HorizontalAlignment="Left" />
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBlock Text="Seed"
                       Margin="0,0,0,4" />
            <TextBox x:Name="SeedInput"
                     Padding="4"
                     MaxWidth="200"
                     HorizontalAlignment="Left" />
        </StackPanel>

        <TextBlock x:Name="StatusText"
                   Grid.Row="3"
                   TextWrapping="Wrap"
                   Foreground="#666666"
                   VerticalAlignment="Top"
                   Visibility="Collapsed" />

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="CancelButton"
                    Content="Cancel"
                    MinWidth="80"
                    Margin="0,0,8,0"
                    Padding="12,4"
                    IsCancel="True"
                    Click="OnCancelClick" />
            <Button x:Name="ExecuteButton"
                    Content="Execute"
                    MinWidth="80"
                    Padding="12,4"
                    IsDefault="True"
                    Click="OnExecuteClick" />
        </StackPanel>
    </Grid>
</Window>
